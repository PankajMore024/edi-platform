{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koneect.local/schema/edi-map.schema.json",
  "title": "EDI Vendor Document Map",
  "description": "Validates a per-(partner, docType, direction) declarative map. See docs/mapping-design.md.",
  "type": "object",
  "required": ["partner", "docType", "direction", "structure"],
  "additionalProperties": true,
  "properties": {
    "$comment": { "type": "string" },
    "partner": { "type": "string", "minLength": 1 },
    "docType": { "type": "string", "enum": ["810", "846", "850", "855", "856", "997"] },
    "direction": { "type": "string", "enum": ["outbound", "inbound"] },
    "functionalId": { "type": "string", "description": "GS01 functional identifier (e.g. PO, IN, SH)." },
    "version": { "type": "string", "description": "GS08 version, e.g. 004010." },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "oneOf": [
        { "$ref": "#/definitions/segmentNode" },
        { "$ref": "#/definitions/loopNode" }
      ]
    },
    "segmentNode": {
      "type": "object",
      "required": ["segment", "elements"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "segment": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,2}$" },
        "when": { "type": "string", "description": "Inclusion predicate over the canonical doc + config." },
        "over": { "type": "string", "description": "Array path to repeat this segment across." },
        "match": { "$ref": "#/definitions/match" },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/element" }
        }
      }
    },
    "loopNode": {
      "type": "object",
      "required": ["loop", "segments"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "loop": { "type": "string", "minLength": 1 },
        "when": { "type": "string" },
        "over": { "type": "string" },
        "match": { "$ref": "#/definitions/match" },
        "hl": { "type": "string", "description": "Marks an HL hierarchy level (e.g. S/O/I for 856); triggers HL id/parent numbering." },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/node" }
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["pos"],
      "additionalProperties": false,
      "description": "Exactly one source of value: path | const | count. default/format/decimal/qualifier are modifiers.",
      "properties": {
        "$comment": { "type": "string" },
        "pos": { "type": "integer", "minimum": 1, "maximum": 99 },
        "path": { "type": "string" },
        "const": { "type": ["string", "number", "boolean"] },
        "count": { "type": "string", "description": "Array path whose length becomes the value." },
        "default": { "type": ["string", "number"] },
        "format": { "type": "string", "enum": ["CCYYMMDD", "YYMMDD", "HHMM", "HHMMSS"] },
        "decimal": { "type": "integer", "minimum": 0, "maximum": 6 },
        "qualifier": {
          "type": "object",
          "required": ["pos", "const"],
          "additionalProperties": false,
          "properties": {
            "pos": { "type": "integer", "minimum": 1, "maximum": 99 },
            "const": { "type": "string" }
          }
        },
        "hl": { "type": "string", "enum": ["id", "parent"], "description": "856 HL hierarchy value: this node's HL id or its parent's HL id." }
      },
      "oneOf": [
        { "required": ["path"] },
        { "required": ["const"] },
        { "required": ["count"] },
        { "required": ["hl"] }
      ]
    },
    "match": {
      "type": "object",
      "description": "Inbound only: identifies which occurrence of a segment/loop this is.",
      "required": ["pos", "eq"],
      "additionalProperties": false,
      "properties": {
        "pos": { "type": "integer", "minimum": 1, "maximum": 99 },
        "eq": { "type": "string" }
      }
    }
  }
}
